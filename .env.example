# Claude Agent SDK uses Claude Code's authentication —
# no separate ANTHROPIC_API_KEY required here.
# Requirement: Claude Code must be installed and authenticated.
# https://docs.claude.com/en/docs/claude-code/quickstart

# Optional: override the model used by the agent.
# Defaults to the model configured in your Claude Code session.
# CLAUDE_MODEL=claude-sonnet-4-6
